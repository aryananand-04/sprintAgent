{
  "name": "sprint-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "spdx": "tsx scripts/spdx.ts",
    "spdx:check": "tsx scripts/spdx.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:env": "tsx scripts/sync-local-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:types": "supabase gen types typescript --local > src/db/database.types.ts",
    "db:seed:gen": "tsx scripts/generate-seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@types/node": "^25.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "groq-sdk": "^1.2.0",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.11.0",
    "postcss": "^8.4.38",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
