# Copy to .env.local. Locally, `npm run db:env` fills the Supabase values for you.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────
# Public URL used in auth redirects (set in production, e.g. https://sprintagent.app)
NEXT_PUBLIC_SITE_URL=
# Comma list of enabled OAuth providers: github,google (enable them in Supabase too)
AUTH_PROVIDERS=
# Local OAuth app credentials (read by supabase/config.jsonc)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── AI (server-only) ──────────────────────────────────────
# Without a key the app runs fully on the deterministic rule engine.
GROQ_API_KEY=

# Outbox retries: the scheduler calls /api/cron/outbox with this bearer token (Vercel sets it for its crons)
CRON_SECRET=

# Background jobs (Inngest). Local: npm run jobs:dev and set INNGEST_DEV=1. Production: keys from app.inngest.com
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── GitHub App (server-only) ──────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The app's private key (.pem), base64-encoded on one line
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
# Local webhook relay (npm run github:webhooks), from smee.io
SMEE_URL=

# ── Slack app (server-only) ───────────────────────────────
# Create the app from docs/slack-app-manifest.json (replace https://YOUR-SITE), then copy these from Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Seals third-party tokens at rest (Slack bot tokens). 32 bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Linear (server-only) ──────────────────────────────────
# linear.app/settings/api/applications/new. Callback URL: <site>/api/trackers/linear/oauth
# Webhook URL: <site>/api/linear/webhook with Issues + Comments + OAuth app events; copy its signing secret
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# ── Jira Cloud (server-only) ──────────────────────────────
# developer.atlassian.com/console/myapps → OAuth 2.0 (3LO). Callback URL: <site>/api/trackers/jira/oauth
# Permissions: Jira API with read:jira-work, write:jira-work, manage:jira-webhook, read:jira-user
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
