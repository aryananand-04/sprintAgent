# Copy to .env.local. Locally, `npm run db:env` fills the Supabase values for you.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────
# Public URL used in auth redirects (set in production, e.g. https://sprintagent.app)
NEXT_PUBLIC_SITE_URL=
# Comma list of enabled OAuth providers: github,google (enable them in Supabase too)
AUTH_PROVIDERS=
# Local OAuth app credentials (read by supabase/config.jsonc)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── AI (server-only) ──────────────────────────────────────
# Without a key the app runs fully on the deterministic rule engine.
GROQ_API_KEY=
